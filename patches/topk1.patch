+// Zeroes each row's per-pass histograms and done counters too, so the passes need no separate reset kernels.
+template<int NBINS, int NPASS>
+static __global__ void top_k_radix_init(top_k_radix_state * states, int * row_histograms, int * done, int nrows, int k) {
+    const int row = blockIdx.x;
+    for (int i = threadIdx.x; i < NPASS*NBINS; i += blockDim.x) {
+        row_histograms[(size_t) row*NPASS*NBINS + i] = 0;
+    }
+    if (threadIdx.x < NPASS) {
+        done[row*NPASS + threadIdx.x] = 0;
+    }
+    if (threadIdx.x == 0) {
         states[row] = {0, 0, k, 0, 0};
     }
+    GGML_UNUSED(nrows);
 }
 
