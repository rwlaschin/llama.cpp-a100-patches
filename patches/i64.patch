+#ifdef GGML_CUDA_MMQ_I64
+// GGML_CUDA_MMQ_I64: on the GA100, decode tiles (J <= 32) take 64 rows and 4 warps instead of 128 rows and 8 warps.
+// A 128-row block needs ~96 KB of shared memory, so one fits per SM and nothing overlaps its load/sync phases;
+// a 64-row block needs ~56 KB, so two co-reside (same 8 warps per SM) and the stream-k split has twice the tiles.
+static constexpr __host__ __device__ ggml_cuda_mmq_config ggml_cuda_mmq_i64(ggml_cuda_mmq_config c) {
+    if (c.J <= 32 && c.nthreads == 256 && c.occupancy == 1 && c.I == 128) {
+        c.nthreads  = 128;
+        c.occupancy = 2;
+        c.I         = 64;
+    }
+    return c;
+}
+#endif // GGML_CUDA_MMQ_I64
