+#ifdef GGML_CUDA_MMQ_Q8_CACHE
+// Arena slot holding src1 quantized for `layout`; `fresh` says it still has to be quantized. nullptr = not cacheable.
+static char * mmq_q8_cache_get(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const int layout, const size_t nbytes,
+        cudaStream_t stream, bool & fresh) {
+    if (!ctx.stream_context().concurrent_events.empty()) { // multi-stream graph: a wipe could race a reader on another stream
+        return nullptr;
+    }
+    for (int i = 0; i < ctx.mmq_q8_n; i++) {
+        const auto & e = ctx.mmq_q8_entries[i];
+        if (e.src1 == src1 && e.data == src1->data && e.layout == layout && e.stream == stream && e.nbytes >= nbytes) {
+            fresh = false;
+            return e.ptr;
+        }
+    }
+    // two of the largest activation: the one its siblings are still reading, plus the next one, so a wipe never evicts a live entry
+    ctx.mmq_q8_want = std::max(ctx.mmq_q8_want, 2 * GGML_PAD(nbytes, 256));
+    if (nbytes > ctx.mmq_q8_cap) {
+        return nullptr;
+    }
+    size_t off = GGML_PAD(ctx.mmq_q8_used, 256);
+    if (ctx.mmq_q8_n == 8 || off + nbytes > ctx.mmq_q8_cap) {
+        ctx.mmq_q8_n = 0;
+        off = 0;
+    }
+    char * p = ctx.mmq_q8_cur + off;
+    ctx.mmq_q8_entries[ctx.mmq_q8_n++] = { src1, src1->data, stream, layout, nbytes, p };
+    ctx.mmq_q8_used = off + nbytes;
+    fresh = true;
+    return p;
+}
