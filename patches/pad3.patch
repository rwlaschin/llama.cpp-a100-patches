+// GGML_CUDA_MMQ_I2F_EXACT: one int8 MMA result is at most 32*128*128 = 2^19 in magnitude, so adding it into the
+// mantissa of 1.5*2^23 and subtracting that back gives exactly (float) x, from full-rate IADD + FADD instead of the
+// quarter-rate I2F convert.
+static __device__ __forceinline__ float ggml_cuda_mmq_i2f(const int x) {
+#ifdef GGML_CUDA_MMQ_I2F_EXACT
+    return __int_as_float(x + 0x4B400000) - 12582912.0f;
+#else
+    return (float) x;
+#endif // GGML_CUDA_MMQ_I2F_EXACT
+}
