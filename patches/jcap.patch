--- a/ggml/src/ggml-cuda/mmq.cu	2026-11-06 17:58:14
+++ b/ggml/src/ggml-cuda/mmq.cu	2026-11-06 18:27:24
@@ -138,13 +138,23 @@
     int J_best        = 0;
     int ntiles_J_best = INT_MAX;
 
-    for (int J = 8; J <= 128 && ntiles_J_best > 1; J += 8) {
+    // GGML_CUDA_MMQ_JMAX: widest tile tried (default 128). Narrower tiles hold fewer accumulators per thread, so
+    // they can avoid the register spills of J=128 at the cost of reading each weight tile more often.
+    static const int J_max = [] { const char * e = getenv("GGML_CUDA_MMQ_JMAX"); const int v = e ? atoi(e) : 0; return v >= 8 && v <= 128 ? v : 128; }();
+    for (int J = 8; J <= J_max && ntiles_J_best > 1; J += 8) {
         const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, J, fallback, cc, prec_src1);
         if (config.type == GGML_TYPE_COUNT) {
             continue;
         }
 
         if (mmq_get_nbytes_shared(config, cc) > smpbo) {
+            // a wider tile that would have cut the tile count does not fit: say so once per type, the drop costs speed
+            static bool warned[GGML_TYPE_COUNT] = {};
+            if ((ncols + config.J - 1) / config.J < ntiles_J_best && !warned[type]) {
+                warned[type] = true;
+                GGML_LOG_WARN("%s: %s J=%d needs %zu B of shared memory, device allows %zu B: using a narrower tile\n",
+                    __func__, ggml_type_name(type), J, mmq_get_nbytes_shared(config, cc), smpbo);
+            }
             continue;
         }
 
